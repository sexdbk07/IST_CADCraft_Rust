{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "IST_CADCraft: build (debug)",
      "type": "cargo",
      "command": "build",
      "args": ["-p", "cadcraft"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "IST_CADCraft: build (release)",
      "type": "cargo",
      "command": "build",
      "args": ["--release", "-p", "cadcraft"],
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "IST_CADCraft: run (release)",
      "type": "cargo",
      "command": "run",
      "args": ["--release", "-p", "cadcraft"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "IST_CADCraft: run with sample drawing",
      "type": "cargo",
      "command": "run",
      "args": ["--release", "-p", "cadcraft", "--", "--sample"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "IST_CADCraft: test (engine + iStCAD UI)",
      "type": "shell",
      "command": "cargo test -p cadcraft-engine --lib -- cmd:: lasso; cargo test -p cadcraft-ui-egui --lib -- istcad theme lasso",
      "problemMatcher": ["$rustc"],
      "group": "test"
    }
  ]
}
